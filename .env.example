# Sao chép file này thành ".env" rồi điền giá trị thật, KHÔNG commit file .env lên git.

# Client ID lấy từ Google Cloud Console (xem hướng dẫn trong README.md)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Domain Google Workspace được phép đăng nhập
ALLOWED_DOMAIN=falcongames.com

# Danh sách email được cấp quyền Admin, cách nhau bằng dấu phẩy
ADMIN_EMAILS=dungdt@falcongames.com,mynth@falcongames.com

# Chuỗi bí mật để ký session — đặt một chuỗi ngẫu nhiên dài, VD chạy:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=doi-chuoi-nay-thanh-ngau-nhien-dai-toi-thieu-32-ky-tu

# Cổng chạy server
PORT=3000

# "production" khi chạy thật (sau Nginx/SSL) để bật cookie secure
NODE_ENV=production
